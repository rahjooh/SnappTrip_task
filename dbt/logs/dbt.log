    CAST(NULL AS TIMESTAMP) as last_updated,
    CAST(NULL AS TIMESTAMP) as dbt_updated_at,
    CURRENT_TIMESTAMP as postgres_updated_at
WHERE FALSE  -- This ensures no rows are inserted, just creates the table structure
  );
  
